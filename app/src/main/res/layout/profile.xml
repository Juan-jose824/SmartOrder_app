<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/gyro_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/circle_border"
        android:scaleType="fitXY"
        android:alpha="0.6" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <!-- Título -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos de usuario"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Nombre -->
            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Francisco Bruni López"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Email -->
            <TextView
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="correo@ejemplo.com"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <!-- Celular -->
            <TextView
                android:id="@+id/tv_cellphone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+52 3312345678"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <!-- Rol -->
            <TextView
                android:id="@+id/tv_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rol: 5"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <!-- Fecha -->
            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025-08-20 12:35"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

        </LinearLayout>
    </ScrollView>

</androidx.wear.widget.BoxInsetLayout>
