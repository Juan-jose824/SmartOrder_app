<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="25dp"
    app:cardElevation="4dp"
    android:background="#00000000">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="@drawable/food_bg_dark">

        <!-- Contenedor de texto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/placeImageContainer"
            android:layout_marginEnd="8dp"
            android:layout_weight="1">

            <!-- Nombre -->
            <TextView
                android:id="@+id/placeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del lugar"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />

            <!-- Descripción -->
            <TextView
                android:id="@+id/placeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Descripción del lugar"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="status"
                android:textColor="@color/text02" />


            <!-- CheckBox flotando arriba a la derecha -->
            <CheckBox
                android:id="@+id/placeCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:text="Seleccionar lugar"
                android:textColor="@color/text01"
                android:background="@android:color/transparent"
                android:buttonTint="@color/text02"
                android:checked="false"
                android:paddingHorizontal="6dp" />

        </LinearLayout>

        <!-- Imagen -->
        <FrameLayout
            android:id="@+id/placeImageContainer"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_alignParentEnd="true">

            <ImageView
                android:id="@+id/placeImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/no_image" />
        </FrameLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
