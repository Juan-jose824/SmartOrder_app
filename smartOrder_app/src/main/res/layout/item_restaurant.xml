<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:minWidth="350dp"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:minWidth="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp"
        android:background="@drawable/item_bg">

        <!-- Imagen principal -->
        <ImageView
            android:id="@+id/restaurant_image"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:src="@drawable/no_image" />

        <!-- Logo + Nombre + Corazón -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="15dp">

            <ImageView
                android:id="@+id/restaurant_logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/no_restaurant_image"
                android:layout_marginEnd="8dp"
                app:tint="@color/text02"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                />

            <TextView
                android:id="@+id/restaurant_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nombre_del_restaurante"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textFontWeight="500"
                android:textColor="@color/text01"/>

            <ImageView
                android:id="@+id/fav_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/favorite"
                app:tint="@color/text02"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                />
        </LinearLayout>

        <!-- Calificación -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp"
            android:paddingHorizontal="18dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="16sp"
                android:textColor="@color/text02" />

            <TextView
                android:id="@+id/full_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/5"
                android:textSize="16sp"
                android:textColor="@color/text02"
                android:layout_marginEnd="5dp"/>

            <ImageView
                android:id="@+id/star_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/star"
                app:tint="@color/text02" />

            <TextView
                android:id="@+id/work_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/abierto"
                android:textSize="16sp"
                android:textAlignment="textEnd"
                android:textColor="@color/text02"
                android:layout_marginEnd="5dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:paddingHorizontal="15dp">

            <TextView
                android:id="@+id/restaurant_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9:00 AM"
                android:textSize="18sp"
                android:textColor="@color/text02"
                android:layout_marginRight="25dp"/>

            <TextView
                android:id="@+id/restaurant_separation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="@color/text02"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/restaurant_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:00 PM"
                android:textSize="18sp"
                android:textColor="@color/text02"
                android:layout_marginLeft="25dp"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>


