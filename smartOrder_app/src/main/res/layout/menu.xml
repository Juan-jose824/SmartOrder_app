<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenido scrolleable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@drawable/general_bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Imagen principal -->
        <ImageView
            android:id="@+id/restaurant_image"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:src="@drawable/no_image" />

        <!-- Logo + Nombre + Corazón -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/restaurant_logo"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/no_restaurant_image"
                android:layout_marginEnd="10dp"
                android:scaleType="centerCrop"
                android:background="@drawable/item_bg" />

            <TextView
                android:id="@+id/restaurant_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre del Restaurante"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text01"/>

            <ImageView
                android:id="@+id/fav_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/favorite"
                app:tint="@color/text02"
                android:adjustViewBounds="true" />
        </LinearLayout>

        <!-- Descripción -->
        <TextView
            android:id="@+id/restaurant_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:text="Aquí va la descripción del restaurante"
            android:textSize="16sp"
            android:textColor="@color/text02" />

        <!-- Horarios (scrollable horizontal) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingVertical="10dp">

            <LinearLayout
                android:id="@+id/hours_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="15dp">

                <!-- Ejemplo de horario -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:background="@drawable/schedule_item_bg"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Domingo"
                        android:textStyle="bold"
                        android:textColor="@color/text01"/>

                    <TextView
                        android:id="@+id/sundayTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:00 - 22:00"
                        android:textColor="@color/text02"
                        android:textSize="18sp"
                        android:textFontWeight="500"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:background="@drawable/schedule_item_bg"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lunes"
                        android:textStyle="bold"
                        android:textColor="@color/text01"/>

                    <TextView
                        android:id="@+id/mondayTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:00 - 22:00"
                        android:textColor="@color/text02"
                        android:textSize="18sp"
                        android:textFontWeight="500"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:background="@drawable/schedule_item_bg"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Martes"
                        android:textStyle="bold"
                        android:textColor="@color/text01"/>

                    <TextView
                        android:id="@+id/TuesdayTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="cerrado"
                        android:textColor="@color/text02"
                        android:textSize="18sp"
                        android:textFontWeight="500"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:background="@drawable/schedule_item_bg"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Miercoles"
                        android:textStyle="bold"
                        android:textColor="@color/text01"/>

                    <TextView
                        android:id="@+id/wednesdayTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="cerrado"
                        android:textColor="@color/text02"
                        android:textSize="18sp"
                        android:textFontWeight="500"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:background="@drawable/schedule_item_bg"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jueves"
                        android:textStyle="bold"
                        android:textColor="@color/text01"/>

                    <TextView
                        android:id="@+id/thursdayTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:00 - 22:00"
                        android:textColor="@color/text02"
                        android:textSize="18sp"
                        android:textFontWeight="500"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:background="@drawable/schedule_item_bg"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Viernes"
                        android:textStyle="bold"
                        android:textColor="@color/text01"/>

                    <TextView
                        android:id="@+id/fridayTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:00 - 22:00"
                        android:textColor="@color/text02"
                        android:textSize="18sp"
                        android:textFontWeight="500"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:background="@drawable/schedule_item_bg"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sabado"
                        android:textStyle="bold"
                        android:textColor="@color/text01"/>

                    <TextView
                        android:id="@+id/saturndayTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:00 - 22:00"
                        android:textColor="@color/text02"
                        android:textSize="18sp"
                        android:textFontWeight="500"/>
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Calificación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.5"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text01"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/5"
                android:textSize="16sp"
                android:textColor="@color/text02"
                android:layout_marginEnd="5dp"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/star"
                app:tint="@color/text02"
                android:textAlignment="center"/>
        </LinearLayout>

        <!-- Lista de categorías de alimentos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:text="@string/men"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="@color/text01" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Alimentos principales"
                android:textColor="@color/text01"
                android:textSize="24sp"
                android:textFontWeight="700"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/foods_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="20dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Todos los alimentos"
                android:textColor="@color/text01"
                android:textSize="24sp"
                android:textFontWeight="700"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/allFoods_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="20dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

    <!-- Botón flotante estilo "ir al carrito" -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        app:srcCompat="@drawable/shopping_cart"
        app:tint="@color/text01"
        android:contentDescription="@string/ir_al_carrito"/>

</FrameLayout>